{
  "name": "core-agent-fleet-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types env.d.ts --include-runtime false --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "npm run verify && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "agents": "0.21.0",
    "ai": "7.0.70",
    "workers-ai-provider": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
